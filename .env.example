# ── Burn Station configuration ───────────────────────────────────────────────
# Copy this file to `.env` and fill in the values below, then restart `npm run dev`.

# Solana RPC endpoint. The public endpoint is rate-limited and CANNOT reliably
# list token accounts or serve NFT images from a browser. Use a free Helius key
# (https://helius.dev) or QuickNode/Alchemy/Triton. Helius also powers NFT images.
VITE_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Wallet that receives the 1% platform fee (taken from reclaimed SOL rent).
# MUST be a valid Solana address. Fees are sent here atomically with each burn.
VITE_FEE_WALLET=REPLACE_WITH_YOUR_SOLANA_ADDRESS

# Platform fee in basis points. 100 = 1%. (Optional; defaults to 100.)
VITE_FEE_BPS=100
