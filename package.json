{
  "name": "burn-station",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Non-custodial Solana dApp to burn SPL / Token-2022 tokens and NFTs and reclaim account rent as SOL.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "@solana-mobile/wallet-standard-mobile": "^0.5.3",
    "@solana/spl-token": "^0.4.9",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/web3.js": "^1.95.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-node-polyfills": "^0.22.0"
  },
  "comment": "rollup override uses the WASM build so `vite build` works on Termux/Android where Rollup's native .node binary can't be dlopened. Harmless elsewhere.",
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4"
  }
}
